# Repo root — Docker wiring only (compose auto-loads this file).
# App config is NOT here. Use be/.env and fe/.env.

NGINX_HTTP_PORT=80

# When port 80 is busy:
# NGINX_HTTP_PORT=8080

# Prod Go image on Docker Hub (go-app + go-queue pull this; no source build on server).
# Publish: make build
GO_APP_IMAGE=youruser/go-app:1.0.0
