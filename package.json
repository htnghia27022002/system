{
  "name": "system",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "setup": "pnpm -C fe install",
    "dev": "pnpm -C fe dev",
    "build": "pnpm -C fe build",
    "test": "pnpm -C fe test:run",
    "lint": "pnpm -C fe lint",
    "docker:up": "docker compose --env-file be/.env --profile dev up --build",
    "docker:down": "docker compose --profile dev --profile prod down"
  }
}
