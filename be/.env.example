# BE — single config file for this app (Docker env_file, queue, local go run, prod deploy).
# Copy to be/.env. Point DB_HOST / REDIS_URL / etc. at your environment's hostnames.

CONFIG_FILE=config.yaml
PORT=8080

# Database (postgres service reads DB_* via compose — keep in sync)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=myapp_pg
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Local host without Docker: DB_HOST=localhost

REDIS_URL=redis://redis:6379
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch:9200
NATS_ENABLED=true
NATS_URL=nats://nats:4222

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

CORS_ORIGINS=http://system.local,http://system.local:8080,http://localhost,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:8080

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_PROVIDERS=google
OAUTH_REDIRECT_URL=http://system.local:8080/auth/callback
