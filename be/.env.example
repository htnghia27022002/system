# BE — single config file for this app (Docker env_file, queue, local go run, prod deploy).
# Copy to be/.env. Point DB_HOST / REDIS_URL / etc. at your environment's hostnames.

CONFIG_FILE=config.yaml
PORT=8080

# Database — prefer DB_URL when set (e.g. managed Postgres / Supabase).
# If DB_URL is set, discrete DB_* fields below are ignored for connections/migrations.
# DB_URL=postgresql://user:pass@host:5432/postgres?sslmode=require
DB_HOST=postgres
DB_PORT=5432
DB_NAME=myapp_pg
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Local host without Docker: DB_HOST=localhost

REDIS_URL=redis://redis:6379
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch:9200
NATS_ENABLED=true
NATS_URL=nats://nats:4222

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

CORS_ORIGINS=http://system.local,http://system.local:8080,http://localhost,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:8080

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_ALLOWED_PROVIDERS=google
OAUTH_REDIRECT_URL=http://system.local:8080/auth/callback

# Local avatar uploads (004-user-profile). Owned by BE — never put in root .env.
# Files land under UPLOAD_DIR/avatars/; public URLs are /api/media/avatars/<uuid>.<ext>
# Docker: ./be is bind-mounted at /app, so relative data/uploads persists on the host at be/data/uploads.
# For a dedicated named volume, mount it onto the same path as UPLOAD_DIR inside the be container.
UPLOAD_DIR=data/uploads

# Webhooks tool (005-webhooks-tool) — no extra env vars required in P1.
# Application enforces captured body size ≤ 1 MiB (HTTP 413 when oversize).
# nginx client_max_body_size is already ≥ 1 MiB (20m); product URL rewrite is edge/nginx.
# Public capture: ANY /api/webhooks/capture/:uuid (also via /tools/webhooks/{uuid} rewrite).
# Owner APIs: JWT under /api/webhooks/inbox* (not /api/admin).
