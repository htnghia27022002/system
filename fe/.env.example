# FE app config — used by Docker (env_file) and local host (pnpm dev).
#
# Docker stack (via nginx):
NEXT_PUBLIC_API_BASE_URL=http://system.local:8080/api
NEXT_PUBLIC_SITE_URL=http://system.local:8080
NEXT_PUBLIC_APP_NAME=System App
NEXT_PUBLIC_USE_MOCK_API=false

# Split local dev (pnpm dev on :3000, BE on :8080):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mock-only (no BE):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
# NEXT_PUBLIC_USE_MOCK_API=true
# NEXT_PUBLIC_MOCK_API_DELAY_MS=1200
